{
  "name": "Snakebox",
  "short_name": "Snakebox",
  "description": "A snake-in-the-box playground for hypercubes Q2 to Q10.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
